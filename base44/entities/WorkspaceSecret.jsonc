{
  "name": "WorkspaceSecret",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Account-scoped secret name, e.g. GITHUB_MCP_TOKEN"
    },
    "value": {
      "type": "string",
      "description": "Secret value, stored ENCRYPTED (AES-256-GCM, sealed with additional authenticated data binding it to this workspace_id + name, so a ciphertext moved to another workspace cannot be decrypted). Written only through shared/workspaceSecrets.ts and decrypted only server-side at the moment the credential is used (opening an MCP connection, calling GitHub for a source-control job). Never returned by any read path, and never placed in AI context, prompts, tool metadata, tool results, logs, errors or versions."
    },
    "description": {
      "type": "string"
    },
    "access": {
      "type": "string",
      "enum": [
        "backend_only"
      ],
      "default": "backend_only"
    },
    "last_used_at": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "system"
      }
    },
    "update": {
      "user_condition": {
        "role": "system"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system"
      }
    }
  }
}