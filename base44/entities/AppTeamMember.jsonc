{
  "name": "AppTeamMember",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "app_user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Role WITHIN the team (owner, admin, member, or a project-defined key)."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invited",
        "removed"
      ],
      "default": "active"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "team_id",
    "app_user_id",
    "status"
  ]
}