{
  "name": "DelegatedCredential",
  "type": "object",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "Stable public identifier of ONE delegated credential, minted server-side. Returned to the app user so generated code can select it for a connector call; never the token value."
    },
    "project_id": {
      "type": "string",
      "description": "Project this credential belongs to. Resolved SERVER-side from the authorized project, never from a client, and every read is filtered by it, so one project's delegated credentials can never be resolved or listed from another."
    },
    "workspace_id": {
      "type": "string",
      "description": "Owning workspace, resolved server-side from the project."
    },
    "app_user_id": {
      "type": "string",
      "description": "The app user who delegated this credential. Resolved SERVER-side from the authenticated session that completed the authorization, never from a client. A connector call may only select a credential whose app_user_id matches the executing user \u2014 another user's credential is never silently substituted."
    },
    "provider_id": {
      "type": "string",
      "description": "Provider-neutral key of the external service this credential authorizes (configured per project). The platform hardcodes no provider names."
    },
    "external_subject": {
      "type": "string",
      "description": "The provider's stable subject id for this credential (the 'sub' claim or equivalent). Unique per project + provider, so one external account can be linked to at most one app user per project."
    },
    "external_email": {
      "type": "string",
      "description": "Email reported by the provider, if any. Scrubbed of token shapes; never a credential."
    },
    "external_profile": {
      "type": "object",
      "additionalProperties": true,
      "description": "Bounded, scrubbed public profile returned by the provider (display name, picture URL). Never a token or client secret."
    },
    "encrypted_access_token": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the access token, sealed with additional authenticated data binding it to this project + credential_id. Never plaintext; a ciphertext moved to another project or credential fails authentication and cannot be decrypted."
    },
    "encrypted_refresh_token": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the refresh token, sealed with the same project + credential_id binding. Absent when the provider does not issue refresh tokens."
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scopes granted by the user for this credential."
    },
    "expires_at": {
      "type": "string",
      "description": "When the access token expires. Refresh is attempted before this time during connector execution."
    },
    "token_endpoint": {
      "type": "string",
      "description": "The provider's token endpoint, stored so a refresh during connector execution can proceed without external provider configuration. The authorization and revoke endpoints are NOT needed for refresh and are not stored here."
    },
    "client_id_secret": {
      "type": "string",
      "description": "NAME of the project secret holding the OAuth client_id, used during refresh. A name only \u2014 the value is resolved from ProjectSecret server-side and never stored here."
    },
    "client_secret_secret": {
      "type": "string",
      "description": "NAME of the project secret holding the OAuth client_secret, used during refresh. A name only."
    },
    "pkce": {
      "type": "boolean",
      "default": false,
      "description": "Whether the provider supports PKCE S256. Recorded so a refresh can include a fresh verifier when the provider requires it."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "refresh_failed",
        "revoked"
      ],
      "default": "active",
      "description": "Lifecycle. Only 'active' may be selected for a connector call. 'expired' is a transient state awaiting refresh; 'refresh_failed' means the refresh token is no longer usable and the user must re-authorize; 'revoked' is terminal."
    },
    "revoked_at": {
      "type": "string"
    },
    "last_refreshed_at": {
      "type": "string"
    },
    "refresh_rotation_count": {
      "type": "number",
      "default": 0,
      "description": "How many times the refresh token has been rotated. Diagnostics only."
    },
    "trace_id": {
      "type": "string",
      "description": "The platform's EXISTING correlation id of the operation that created or last refreshed this credential. The delegated OAuth layer mints no second trace system."
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "credential_id",
    "project_id",
    "app_user_id",
    "provider_id",
    "status"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "system"
      }
    },
    "update": {
      "user_condition": {
        "role": "system"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system"
      }
    }
  }
}