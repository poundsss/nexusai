{
  "name": "ProjectSecret",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Secret name referenced by backend functions, e.g. WEATHER_API_KEY"
    },
    "value": {
      "type": "string",
      "description": "Secret value. Never returned by project read APIs, never placed in AI context, versions, logs or generated bundles. Read only by the server-side function executor."
    },
    "description": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "access": {
      "type": "string",
      "enum": [
        "backend_only"
      ],
      "default": "backend_only",
      "description": "Access policy. Only server-side function execution may read the value."
    },
    "last_used_at": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "system"
      }
    },
    "update": {
      "user_condition": {
        "role": "system"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system"
      }
    }
  }
}