{"name": "googlecalendar", "type": "http", "base_url": "https://www.googleapis.com", "description": "Google Calendar — delegated OAuth for Calendar events push (web_hook watch channels). Phase 1 connector-event ingestion (Calendar only; no Gmail/Pub/Sub).", "delegated_oauth": {"authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth", "token_endpoint": "https://oauth2.googleapis.com/token", "client_id_secret": "GOOGLE_OAUTH_CLIENT_ID", "client_secret_secret": "GOOGLE_OAUTH_CLIENT_SECRET", "scopes": ["https://www.googleapis.com/auth/calendar.events.readonly"], "pkce": true}}