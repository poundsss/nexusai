{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_schedule_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agentScheduleTick"
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep due agent schedules",
            "description": "Fire due scheduled Superagent automations"
          }
        }
      }
    ]
  },
  "name": "Agent Schedule Tick",
  "description": "Sweeps due AgentSchedule records every five minutes (the platform's workflow cadence floor, matching the certified Scheduled Triggers sweep) and enqueues an AgentRun (the certified Agent Executor picks it up) for each due occurrence",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}