{
  "name": "Agent Executor",
  "description": "Durable background execution for agent runs: repeatedly advances the agent's observe/act/verify loop, waiting between invocations while a delegated builder run finishes. Independent of the browser. 60 iterations (~8 minutes of 8s cadence) so a run waiting on a delegated builder run is driven to completion without idling until the 5-minute reaper; the reaper remains the safety net beyond that.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AgentRun",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"QUEUED\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_executor",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "iter_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agentStep",
            "args": {
              "agent_run_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check_1",
          "x-base44": {
            "title": "Agent iterations 1"
          }
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .iter_1.done == true }",
              "then": "end"
            },
            {
              "when": "${ true }",
              "then": "wait_1"
            }
          ],
          "x-base44": {
            "title": "More work?"
          }
        }
      },
      {
        "wait_1": {
          "wait": "PT8S",
          "then": "iter_2",
          "x-base44": {
            "title": "Let the builder run progress"
          }
        }
      },
      {
        "iter_2": {
          "call": "invoke_backend_function",
