{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scheduled_triggers",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runScheduledTriggers"
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep due triggers",
            "description": "Execute due scheduled functions"
          }
        }
      }
    ]
  },
  "name": "Scheduled Triggers",
  "description": "Sweeps and executes due scheduled triggers for deployed apps every 5 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}