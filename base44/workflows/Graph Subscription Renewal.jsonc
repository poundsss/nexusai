{
  "name": "Graph Subscription Renewal",
  "description": "Every 15 minutes, renews Microsoft Graph change-notification subscriptions (Outlook / OneDrive) whose expiration is within the renewal lead window. Each renewal PATCHes the existing subscription and never creates a duplicate.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "graph_subscription_renewal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "renew": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "msGraphSubscriptionRenew"
          },
          "then": "end",
          "x-base44": {
            "title": "Renew expiring Graph subscriptions",
            "description": "PATCH Outlook/OneDrive subscriptions before their expirationDateTime"
          }
        }
      }
    ]
  }
}